# Copy to .env and fill in. Schema lives in src/env.js.

# Postgres (local: ./start-database.sh). Also used by Mastra Memory (@mastra/pg).
DATABASE_URL="postgresql://postgres:password@localhost:5433/lessonplay"

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Vercel AI Gateway — https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=""

# Daytona — sandbox per chat thread (https://app.daytona.io)
DAYTONA_API_KEY=""
# DAYTONA_ORGANIZATION_ID=""   # JWT auth only; leave unset when using an API key
# Base snapshot name. Build it with `pnpm snapshot:build`, then set it here.
DAYTONA_SNAPSHOT="lessonplay-base-v4"

# Cloudflare R2 — game files, FUSE-mounted into the sandbox at ~/game.
# Use a bucket dedicated to LessonPlay: every thread gets games/<userId>/<threadId>/.
R2_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public origin for the bucket. Only needed to preview/publish a built game.
R2_PUBLIC_BASE_URL=""
