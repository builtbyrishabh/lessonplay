{
  "name": "lessonplay",
  "version": "0.1.0",
  "private": true,
  "description": "Give it a chemistry chapter. Get a playable lab. An AI studio that writes, validates, and publishes chemistry learning games.",
  "license": "Apache-2.0",
  "author": "Rishabh Singh",
  "homepage": "https://github.com/builtbyrishabh/lessonplay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/builtbyrishabh/lessonplay.git"
  },
  "bugs": {
    "url": "https://github.com/builtbyrishabh/lessonplay/issues"
  },
